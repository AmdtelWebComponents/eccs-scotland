---
interface Props {
  title: string;
  eyebrow: string;
  subtitle: string;
  image: string;
  secondImage?: string;
  ctaHref?: string;
}

const { title, eyebrow, subtitle, image, secondImage, ctaHref = "/contact/" } = Astro.props;
---

<section class="hero" aria-labelledby="page-title">
  <div class:list={["hero-images", { "hero-images-animated": secondImage }]} aria-hidden="true">
    <img class="hero-image hero-image-first" src={image} alt="" fetchpriority="high" />
    {secondImage && <img class="hero-image hero-image-second" src={secondImage} alt="" />}
  </div>
  <div class="hero-copy">
    <p class="eyebrow">{eyebrow}</p>
    <h1 id="page-title">{title}</h1>
    <p class="hero-subtitle">{subtitle}</p>
    <a class="button button-outline" href={ctaHref}>Get a consultation <span aria-hidden="true">&#8599;</span></a>
  </div>
</section>

<style>
  .hero { position: relative; isolation: isolate; display: flex; min-height: min(760px, 90svh); align-items: center; overflow: hidden; padding: 12rem clamp(1.5rem, 8vw, 8rem) 6rem; color: white; background: #282926; }
  .hero-images, .hero-images::after, .hero-image { position: absolute; inset: 0; width: 100%; height: 100%; }
  .hero-images { z-index: -1; }
  .hero-images::after { content: ""; background: linear-gradient(90deg, rgb(20 21 20 / 78%), rgb(20 21 20 / 28%)); }
  .hero-image { object-fit: cover; object-position: center; }
  .hero-images-animated .hero-image { opacity: 0; animation: crossfade 12s ease-in-out infinite; }
  .hero-images-animated .hero-image-first { animation-delay: -0.6s; }
  .hero-images-animated .hero-image-second { animation-delay: 5.4s; }
  @keyframes crossfade { 0%, 50%, 100% { opacity: 0; } 5%, 45% { opacity: 1; } }
  .hero-copy { max-width: 56rem; }
  .hero .eyebrow { color: #e8caa5; }
  h1 { margin: 0; font: 400 5rem/1.05 var(--font-display); overflow-wrap: anywhere; }
  .hero-subtitle { margin: 1.5rem 0 2.5rem; font-size: 1.35rem; }
  @media (max-width: 680px) { .hero { min-height: 640px; padding: 12rem 1.5rem 5rem; } h1 { font-size: 3rem; } }
  @media (prefers-reduced-motion: reduce) { .hero-images-animated .hero-image { animation: none; } .hero-images-animated .hero-image-first { opacity: 1; } .hero-images-animated .hero-image-second { opacity: 0; } }
</style>