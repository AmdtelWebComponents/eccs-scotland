---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { site, services } from "../site.config";
---

<BaseLayout title={site.name}>
  <main>
    <PageHero {...site.pages.home} />
    <section class="intro-band section-wrap">
      <div><p class="eyebrow">A considered approach</p><h2>A clean space makes<br /><em>all the difference.</em></h2></div>
      <div><p>From the everyday to the exceptional, we bring care and attention to the spaces where you live and work.</p><a class="text-link" href="/about/">Get to know us <span aria-hidden="true">&#8599;</span></a></div>
    </section>
    <section class="service-preview">
      <div class="section-wrap">
        <div class="section-heading"><div><p class="eyebrow">What we do</p><h2>Cleaning that fits <em>your world.</em></h2></div><a class="text-link" href="/services/">Explore all services <span aria-hidden="true">&#8599;</span></a></div>
        <div class="preview-grid">{services.map((service) => <article><a href="/services/"><img src={service.image} alt="" loading="lazy" /><h3>{service.title} <span aria-hidden="true">&#8599;</span></h3></a><p>{service.description}</p></article>)}</div>
      </div>
    </section>
    <section class="cta-band"><p class="eyebrow">Let's get started</p><h2>Ready for a <em>better clean?</em></h2><a class="button button-dark" href="/contact/">Get in touch <span aria-hidden="true">&#8599;</span></a></section>
  </main>
</BaseLayout>