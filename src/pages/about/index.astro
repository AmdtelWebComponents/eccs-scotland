---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import { site } from "../../site.config";
---

<BaseLayout title={`${site.pages.about.title} | ${site.name}`}>
  <main>
    <PageHero {...site.pages.about} />
    <section class="intro-band section-wrap">
      <div><p class="eyebrow">Our story</p><h2>High standards.<br /><em>Thoughtful service.</em></h2></div>
      <div><p>At {site.name}, we believe a well-cared-for space makes a difference. We take time to understand your needs and bring a personal approach to every job.</p><p>Based in {site.area}, we offer cleaning services for homes, businesses and the people who care for them.</p><a class="text-link" href="/services/">Explore our services <span aria-hidden="true">&#8599;</span></a></div>
    </section>
    <section class="image-feature section-wrap"><img src="/images/about-hero.jpg" alt="A clean, light-filled interior" loading="lazy" /><div><p class="eyebrow">Care in every detail</p><h2>Made for <em>your space.</em></h2><p>Every property is different. We work with you to find the right approach for your space and schedule.</p><a class="text-link" href="/contact/">Start a conversation <span aria-hidden="true">&#8599;</span></a></div></section>
  </main>
</BaseLayout>