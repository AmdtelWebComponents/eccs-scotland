---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import { site, services } from "../../site.config";
---

<BaseLayout title={`${site.pages.contact.title} | ${site.name}`}>
  <main>
    <PageHero {...site.pages.contact} ctaHref="#consultation" />
    <section class="contact-body section-wrap">
      <div class="contact-details">
        <p class="eyebrow">Get in touch</p><h2>How can we <em>help you?</em></h2>
        <p>Tell us a little about your property and what you need. We would love to hear from you.</p>
        {site.phone ? <a href={`tel:${site.phone.replace(/\s/g, "")}`}>{site.phone}</a> : <span>Your phone number</span>}
        {site.email ? <a href={`mailto:${site.email}`}>{site.email}</a> : <span>your@email.com</span>}
        <p>{site.area}</p>
      </div>
      <form id="consultation" class="consult-form" name="consultation" method="POST" data-netlify="true">
        <input type="hidden" name="form-name" value="consultation" />
        <label>Name<input name="name" autocomplete="name" required /></label>
        <label>Email<input type="email" name="email" autocomplete="email" required /></label>
        <label>Service required<select name="service" required><option value="" disabled selected>Select a service</option>{services.map((service) => <option value={service.title}>{service.title}</option>)}</select></label>
        <label>Message<textarea name="message" rows="5" required></textarea></label>
        <button class="button button-dark" type="submit">Send enquiry <span aria-hidden="true">&#8599;</span></button>
      </form>
    </section>
  </main>
</BaseLayout>