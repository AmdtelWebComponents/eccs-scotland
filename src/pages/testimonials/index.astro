---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import { site, testimonials } from "../../site.config";
---

<BaseLayout title={`${site.pages.testimonials.title} | ${site.name}`}>
  <main>
    <PageHero {...site.pages.testimonials} />
    <section class="testimonial-band">
      {testimonials.map((testimonial) => (
        <article class="testimonial-card">
          {testimonial.logo && <img class="testimonial-logo" src={testimonial.logo} alt={testimonial.logoAlt || `${testimonial.clientName} logo`} />}
          <p class="eyebrow">Client testimonial</p>
          <blockquote>{testimonial.quote}</blockquote>
          <p class="testimonial-author">
            {testimonial.clientName}
            {[testimonial.clientTitle, testimonial.company, testimonial.location].filter(Boolean).length > 0 && (
              <span>{[testimonial.clientTitle, testimonial.company, testimonial.location].filter(Boolean).join(" · ")}</span>
            )}
          </p>
        </article>
      ))}
    </section>
    <section class="cta-band"><p class="eyebrow">Your space could be next</p><h2>Let's make a good <em>first impression.</em></h2><a class="button button-dark" href="/contact/">Get in touch <span aria-hidden="true">&#8599;</span></a></section>
  </main>
</BaseLayout>