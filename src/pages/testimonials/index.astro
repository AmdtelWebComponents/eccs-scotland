---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import { site } from "../../site.config";
---

<BaseLayout title={`${site.pages.testimonials.title} | ${site.name}`}>
  <main>
    <PageHero {...site.pages.testimonials} />
    <section class="testimonial-band"><div><p class="eyebrow">Client testimonial</p><blockquote>"Your client testimonial goes here."</blockquote><p class="testimonial-author">Client name <span>Company or location</span></p></div></section>
    <section class="cta-band"><p class="eyebrow">Your space could be next</p><h2>Let's make a good <em>first impression.</em></h2><a class="button button-dark" href="/contact/">Get in touch <span aria-hidden="true">&#8599;</span></a></section>
  </main>
</BaseLayout>