---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import { site, services } from "../../site.config";
---

<BaseLayout title={`${site.pages.services.title} | ${site.name}`}>
  <main>
    <PageHero {...site.pages.services} />
    <section class="service-list section-wrap" aria-label="Our cleaning services">
      {services.map((service, index) => <article class="service-item"><img src={service.image} alt="" loading="lazy" /><div><p class="eyebrow">Service {String(index + 1).padStart(2, "0")}</p><h2>{service.title}</h2><p>{service.description}</p><a class="text-link" href="/contact/">Ask about this service <span aria-hidden="true">&#8599;</span></a></div></article>)}
    </section>
    <section class="cta-band"><p class="eyebrow">Let's talk</p><h2>Find the right <em>cleaning plan.</em></h2><a class="button button-dark" href="/contact/">Get in touch <span aria-hidden="true">&#8599;</span></a></section>
  </main>
</BaseLayout>